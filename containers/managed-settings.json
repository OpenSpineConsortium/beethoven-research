{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_about": [
    "Baked into the substrate image at /etc/claude-code/managed-settings.json (Linux's managed path),",
    "the top of Claude Code's settings precedence: no project, user or --settings file loosens a rule",
    "here. It carries only what must never be loosened: the deny rules, the bypass lock, the hard",
    "timeouts and memory cap, no self-update of a read-only image, no telemetry, and the guard hook.",
    "Everything a job tunes per step (effort level, subagent concurrency, the auto-compact window,",
    "the run directory) stays OUT of this file, because an env value here overwrites the same",
    "variable exported by the job. Names checked against code.claude.com/docs on 2026-10-04.",
    "Beethoven runs Claude Code and is not an Anthropic product."
  ],
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(sudo *)", "Bash(su *)", "Bash(su)", "Bash(doas *)",
      "Bash(rm -r*)", "Bash(rm -R*)", "Bash(rm -f*)", "Bash(rm --recursive*)", "Bash(rm --force*)",
      "Bash(find * -delete*)", "Bash(find * -exec rm*)", "Bash(shred *)",
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)", "Bash(git clean *)",
      "Bash(chmod -R *)", "Bash(chown -R *)", "Bash(chgrp -R *)",
      "Bash(dd *)", "Bash(mkfs*)", "Bash(fdisk *)", "Bash(shutdown*)", "Bash(reboot*)", "Bash(systemctl *)",
      "Bash(kill -9 -1*)", "Bash(pkill *)", "Bash(killall *)", "Bash(nohup *)", "Bash(setsid *)", "Bash(crontab *)",
      "Bash(ssh *)", "Bash(scp *)", "Bash(sftp *)", "Bash(nc *)", "Bash(ncat *)", "Bash(telnet *)", "Bash(socat *)",
      "Bash(sacctmgr *)", "Bash(scontrol update*)", "Bash(scontrol hold*)", "Bash(scontrol release*)",
      "Bash(scontrol requeue*)", "Bash(scontrol reconfigure*)", "Bash(scontrol cancel*)",
      "Bash(scancel -A *)", "Bash(scancel --account*)", "Bash(scancel -p *)", "Bash(scancel --partition*)",
      "Bash(claude setup-token*)", "Bash(claude auth logout*)",
      "Read(//claude/**)", "Read(~/.claude/**)", "Read(**/.credentials.json)", "Read(**/.claude.json)",
      "Read(~/.ssh/**)", "Read(**/.env)", "Read(**/.env.*)", "Read(**/*.pem)", "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)", "Read(**/.netrc)",
      "Edit(//claude/**)", "Edit(//etc/**)", "Edit(//usr/**)", "Edit(//opt/**)", "Edit(//var/**)", "Edit(//boot/**)"
    ]
  },
  "allowManagedHooksOnly": true,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "MCP_TIMEOUT": "30000",
    "MCP_TOOL_TIMEOUT": "600000",
    "MAX_MCP_OUTPUT_TOKENS": "25000",
    "CLAUDE_CODE_TOOL_MEMORY_LIMIT": "16G",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_UPDATES": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/beethoven-research/.pixi/envs/default/bin/python /opt/beethoven-research/hooks/guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/beethoven-research/.pixi/envs/default/bin/python /opt/beethoven-research/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
