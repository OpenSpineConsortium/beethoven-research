# Pixi's solved environment: reconstructable from pixi.lock, never committed.
.pixi/

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Apptainer images are large and are never committed. The substrate image is beethoven-agents'; the
# study image that layers on it (plan/REPO_SPLIT.md section 2) will be built on the grid from its
# recipe here, with its recorded digest committed beside the recipe and the .sif itself not.
*.sif

# Secrets never enter the repository (see CLAUDE.md). The real values live in the environment.
.env
.env.*
*.pem

# Worktrees Claude Code creates for parallel sessions and isolated subagents.
.claude/worktrees/

# The file Claude Code writes on an "always allow" answer: one person's permissions, never shared,
# and an untracked file would make the pre-push hook refuse every push from that checkout.
.claude/settings.local.json

# OS / editor noise
.DS_Store
Thumbs.db
*.log
